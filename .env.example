# NUNCA publique este arquivo com segredos reais.
PORT=3000

# PIN para desbloquear o painel (uso pessoal, uma pessoa só).
DASHBOARD_PIN=

# Turso (banco de dados permanente — sem isso, os dados somem a cada deploy no Render).
# Pegue esses dois valores no dashboard do turso.tech, dentro do seu banco de dados.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# LocationIQ (busca de empresas na aba "Buscar" — grátis, 5.000 buscas/dia).
# Pegue a chave em locationiq.com, é só criar conta.
LOCATIONIQ_API_KEY=
